# Marketing site (apps/marketing). All optional; defaults are placeholders.
# Public address of this site: canonical URLs, sitemap, Open Graph.
VITE_SITE_URL=https://newfork.example
# The app (apps/web). Sign in / Create account buttons open $VITE_APP_URL/sign-in.
VITE_APP_URL=https://app.newfork.example
# Optional: POST endpoint for the contact form (JSON). Without it the form opens an email.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_SALES_EMAIL=sales@newfork.example
VITE_CONTACT_SUPPORT_EMAIL=support@newfork.example
VITE_CONTACT_PRIVACY_EMAIL=privacy@newfork.example
VITE_CONTACT_SECURITY_EMAIL=security@newfork.example
VITE_CONTACT_GENERAL_EMAIL=hello@newfork.example
