{
  "name": "@newfork/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:vercel": "esbuild src/app.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/vercel-app.cjs && node scripts/copy-geo-tz-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@newfork/scheduling-shared": "workspace:*",
    "@newfork/shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "exceljs": "4.4.0",
    "fastify": "^5.5.0",
    "geo-tz": "8.1.8",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "22",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
