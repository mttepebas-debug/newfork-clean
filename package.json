{
  "name": "newfork-clean",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @newfork/web dev",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "node --test scripts/lock.test.mjs scripts/coord-hooks.test.mjs && turbo test",
    "test:db": "node scripts/reload-test-builder.mjs && supabase test db",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "turbo lint",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <4": "^3.1.8",
      "fast-uri@>=4": "^4.2.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
