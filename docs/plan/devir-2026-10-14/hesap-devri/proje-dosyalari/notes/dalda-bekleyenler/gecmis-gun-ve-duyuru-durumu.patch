 function isArchived(item: AnnouncementRecord) {
   return Boolean(item.archived_at);
 }
+const displayStatusLabels: Record<string, string> = {
+  publish_failed: "Couldn't publish",
+};
+function displayStatus(item: AnnouncementRecord) {
+  return isArchived(item) ? "archived" : (item.display_status ?? item.status);
+}
+function statusTone(status: string) {
+  if (status === "published") return "green";
+  if (status === "scheduled") return "amber";
+  if (status === "publish_failed") return "red";
+  return "gray";
+}
 function statusLabel(item: AnnouncementRecord) {
-  return isArchived(item) ? "Archived" : capitalize(item.status);
+  const status = displayStatus(item);
+  return displayStatusLabels[status] ?? capitalize(status);
 }
 function capitalize(value: string) {
   return value.charAt(0).toUpperCase() + value.slice(1);
