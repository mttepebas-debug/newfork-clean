+                <span className="shift-v-cell">
+                  {time(item.default_start_time)} – {time(item.default_end_time)}
+                  {item.crosses_midnight ? <span className="shift-v-next"> · Ends next day</span> : null}
+                </span>
+                <span className="shift-v-cell">{lengthText(item.default_start_time, item.default_end_time)}</span>
+                <span className="shift-v-cell shift-v-day">
+                  <DayBar start={item.default_start_time} end={item.default_end_time} color={item.color} />
