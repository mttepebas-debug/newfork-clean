+  onEdit: (item: T) => void;
+  onMove: (id: string, direction: -1 | 1) => void;
+  onArchive: (item: T) => void;
+  disabled: boolean;
+  reorderPending: boolean;
+  archivePending: boolean;
+  onAdd?: () => void;
+  addDisabled: boolean;
+  canEdit: boolean;
+  hasAny: boolean;
+}) {
+  const noun = types ? "shift type" : "shift label";
+  const rich = types && shiftCatalogVariant === "C";
+  const rowClass = `shift-v-row ${types ? (rich ? "shift-v-rich" : "shift-v-times") : "shift-v-name"}`;
+  const statusTabs = (
+    <div className="catalog-status-tabs" role="tablist" aria-label={`Shift ${types ? "type" : "label"} status`}>
