--- /dev/null
+++ b/apps/web/src/settings/shift-catalog-variants.css
@@ -0,0 +1,127 @@
+/* Design preview only: Shift catalog in the shared list language (A, B, C). */
+.shift-v-page.list-page .shift-v-row {
+  display: grid;
+  align-items: center;
+  gap: 12px;
+}
+.shift-v-page.list-page .shift-v-row.shift-v-times {
+  grid-template-columns: minmax(0, 46fr) minmax(0, 24fr) minmax(0, 30fr) 32px;
+}
+.shift-v-page.list-page .shift-v-row.shift-v-name {
+  grid-template-columns: minmax(0, 1fr) 32px;
+}
+.shift-v-page.list-page .shift-v-row.shift-v-rich {
+  grid-template-columns: minmax(0, 24fr) minmax(0, 28fr) minmax(0, 12fr) minmax(0, 36fr) 32px;
+}
+.shift-v-page.list-page .job-catalog-row.shift-v-row {
+  min-height: 52px;
+  padding: 0 14px;
+}
+.shift-v-page.list-page .job-catalog-row .job-row-identity {
+  gap: 10px;
+}
+.shift-v-page .shift-v-cell {
+  min-width: 0;
+  overflow: hidden;
+  color: var(--theme-list-cell-text);
+  font-size: 13px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.shift-v-page .shift-v-next {
+  color: var(--theme-muted);
+}
+.shift-v-page .shift-v-card-line {
+  display: none;
+}
+.shift-v-page .shift-v-add {
+  display: contents;
+}
+.shift-v-page .job-catalog-row[data-archived="true"] .job-row-identity:disabled {
+  color: var(--theme-text);
+  opacity: 1;
+}
+/* The day bar (C): 12 AM to 12 AM, the shift's hours in its own color. */
+.shift-v-page .shift-day-bar {
+  position: relative;
+  display: block;
+  height: 10px;
+  border-radius: 999px;
+  background: var(--theme-surface-muted);
+  overflow: hidden;
+}
+.shift-v-page .shift-day-tick {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 1px;
+  background: var(--theme-border);
+}
+.shift-v-page .shift-day-fill {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  border-radius: 999px;
+}
+.shift-v-page .shift-v-day-heading {
+  display: flex;
+  justify-content: space-between;
+  font-size: 10px;
+  letter-spacing: 0.02em;
+}
+.shift-v-page .shift-v-heading {
+  min-width: 0;
+}
+.shift-v-page .catalog-status-tabs button:disabled {
+  cursor: default;
+}
+/* Phone (UI-14): one card per entry, like Locations. */
+@media (max-width: 720px) {
+  .shift-v-page.list-page .shift-v-catalog {
+    display: grid;
+    gap: 8px;
+    overflow: visible;
+    border: 0;
+    background: none;
+  }
+  .shift-v-page.list-page .shift-v-catalog .job-column-headings,
+  .shift-v-page .shift-v-cell {
+    display: none;
+  }
+  .shift-v-page.list-page .job-catalog-row.shift-v-row {
+    grid-template-columns: minmax(0, 1fr) 44px;
+    align-items: start;
+    min-height: 0;
+    padding: 14px 4px 14px 14px;
+    border: 1px solid var(--theme-list-frame);
+    border-radius: 8px;
+  }
+  .shift-v-page.list-page .job-row-identity {
+    min-height: 0;
+    align-items: flex-start;
+  }
+  .shift-v-page.list-page .job-color-dot {
+    margin-top: 7px;
+  }
+  .shift-v-page.list-page .job-row-name {
+    font-size: 15px;
+    line-height: 22px;
+  }
+  .shift-v-page .shift-v-card-line {
+    display: block;
+    margin-top: 2px;
+    color: var(--theme-list-cell-text);
+    font-size: 13px;
+    line-height: 18px;
+  }
+  .shift-v-page.list-page .job-row-menu > summary {
+    width: 40px;
+    height: 40px;
+  }
+  .shift-v-page.list-page .shift-v-catalog:has(> .catalog-table-empty) {
+    display: block;
+    overflow: hidden;
+    border: 1px solid var(--theme-list-frame);
+    border-radius: 8px;
+  }
+}
