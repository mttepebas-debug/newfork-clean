@@ -0,0 +1,16 @@
+// Design preview only (not for main): which Shift catalog design to draw.
+// The preview page puts "v=A|B|C" in the frame's hash or name; none = today's.
+export type ShiftCatalogVariant = "O" | "A" | "B" | "C";
+
+function read(): ShiftCatalogVariant {
+  if (typeof window === "undefined") return "O";
+  const fromHash = new URLSearchParams(window.location.hash.slice(1)).get("v");
+  const fromName = window.name.startsWith("pages:")
+    ? new URLSearchParams(window.name.slice(6)).get("v")
+    : null;
+  const value = (fromHash ?? fromName ?? "O").toUpperCase();
+  return value === "A" || value === "B" || value === "C" ? value : "O";
+}
+
+export const shiftCatalogVariant: ShiftCatalogVariant = read();
+export const shiftCatalogRedesign = shiftCatalogVariant !== "O";
