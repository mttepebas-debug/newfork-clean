+/** Minutes from start to end, across midnight when the end is earlier. */
+function lengthText(start?: string | null, end?: string | null): string {
+  if (!start || !end) return "—";
+  const minutes = (value: string) => {
+    const [h, m] = value.split(":").map(Number);
+    return (h ?? 0) * 60 + (m ?? 0);
+  };
+  let span = minutes(end) - minutes(start);
+  if (span <= 0) span += 24 * 60;
+  const hours = Math.floor(span / 60);
+  const rest = span % 60;
+  return rest ? `${hours} h ${rest} min` : `${hours} h`;
+}
+
+/** The day from 12 AM to 12 AM with the shift's hours in its own color. */
+function DayBar({ start, end, color }: { start?: string | null; end?: string | null; color: string }) {
+  if (!start || !end) return <span className="shift-day-bar" aria-hidden />;
+  const at = (value: string) => {
+    const [h, m] = value.split(":").map(Number);
+    return (((h ?? 0) * 60 + (m ?? 0)) / (24 * 60)) * 100;
+  };
+  const from = at(start);
+  const to = at(end);
+  const parts = to > from ? [[from, to]] : [[from, 100], [0, to]];
+  return (
+    <span className="shift-day-bar" aria-hidden>
+      {[25, 50, 75].map((tick) => (
+        <span key={tick} className="shift-day-tick" style={{ left: `${tick}%` }} />
+      ))}
+      {parts.map(([a, b]) => (
+        <span
+          key={a}
+          className="shift-day-fill"
+          style={{ left: `${a}%`, width: `${b! - a!}%`, backgroundColor: color }}
+        />
+      ))}
+    </span>
+  );
+}
