{
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @newfork/api build:vercel && pnpm --filter \"@newfork/web...\" build && node scripts/sentry-sourcemaps.mjs",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/dist/geo-tz-data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api?__path=/v1/:path*"
    },
    {
      "source": "/schedule/:path*",
      "destination": "/api?__path=/schedule/:path*"
    },
    {
      "source": "/shifts",
      "destination": "/api?__path=/shifts"
    },
    {
      "source": "/shifts/:path*",
      "destination": "/api?__path=/shifts/:path*"
    },
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/((?!api/|v1/|schedule/|shifts|health).*)",
      "destination": "/index.html"
    }
  ]
}
