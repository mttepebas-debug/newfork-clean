{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push*--delete*)",
      "Bash(git *push* -d *)",
      "Bash(git *push*--mirror*)",
      "Bash(git *push*--prune*)",
      "Bash(git *reset --hard*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git *worktree remove*--force*)",
      "Bash(git *worktree remove* -f*)",
      "Bash(git *branch -D main*)",
      "Bash(git *checkout -- .*)",
      "Bash(git *checkout .*)",
      "Bash(git *restore .*)",
      "Bash(*--no-verify*)",
      "Bash(*supabase db reset*)",
      "Bash(*supabase:reset*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase link*)",
      "Bash(*--db-url*)",
      "Bash(*supabase * --linked*)",
      "Bash(*supabase stop*--no-backup*)",
      "Bash(*supabase functions deploy*)",
      "Bash(*supabase secrets*)",
      "Bash(pnpm* add *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(gh repo delete*)",
      "Bash(taskkill *node*)",
      "Bash(taskkill /IM *)",
      "Bash(taskkill /F /IM *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "PowerShell(git *push*--force*)",
      "PowerShell(git *push* -f*)",
      "PowerShell(git *push* +*)",
      "PowerShell(git *push*--delete*)",
      "PowerShell(git *push* -d *)",
      "PowerShell(git *push*--mirror*)",
      "PowerShell(git *push*--prune*)",
      "PowerShell(git *reset --hard*)",
      "PowerShell(git *stash drop*)",
      "PowerShell(git *stash clear*)",
      "PowerShell(git clean*)",
      "PowerShell(git -C * clean*)",
      "PowerShell(git *worktree remove*--force*)",
      "PowerShell(git *worktree remove* -f*)",
      "PowerShell(git *branch -D main*)",
      "PowerShell(git *checkout -- .*)",
      "PowerShell(git *checkout .*)",
      "PowerShell(git *restore .*)",
      "PowerShell(*--no-verify*)",
      "PowerShell(*supabase db reset*)",
      "PowerShell(*supabase:reset*)",
      "PowerShell(*supabase db push*)",
      "PowerShell(*supabase link*)",
      "PowerShell(*--db-url*)",
      "PowerShell(*supabase * --linked*)",
      "PowerShell(*supabase stop*--no-backup*)",
      "PowerShell(*supabase functions deploy*)",
      "PowerShell(*supabase secrets*)",
      "PowerShell(pnpm* add *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "PowerShell(gh repo delete*)",
      "PowerShell(taskkill *node*)",
      "PowerShell(taskkill /IM *)",
      "PowerShell(taskkill /F /IM *)",
      "PowerShell(pkill *)",
      "PowerShell(killall *)",
      "PowerShell(Stop-Process -Name *)",
      "PowerShell(Stop-Process -ProcessName *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/decision-log.mjs\" hook pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/decision-log.mjs\" hook post",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks.mjs\" agent-report", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks.mjs\" session-start", "timeout": 15 }
        ]
      }
    ]
  }
}
